# Docker Compose 使用。复制为 .env，并分别生成三个随机值。
POSTGRES_PASSWORD=replace-with-a-random-database-password
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
KEK_MASTER_KEY=replace-with-another-random-secret-at-least-32-characters

LLM_DEFAULT_PROVIDER=deepseek
LLM_DEEPSEEK_API_KEY=
LLM_QWEN_API_KEY=
LLM_DOUBAO_API_KEY=
LLM_ZHIPU_API_KEY=
LLM_ZHIPU_MODEL=glm-4.7-flash
LLM_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_ZHIPU_THINKING_ENABLED=false
LLM_MATH_PROVIDER=deepseek
