# ============================================================================
# Askora v1 — Local Web 默认配置（最终用户运行路径）
#
# 正常使用 Askora 只需：本机运行 + 浏览器访问 127.0.0.1。
# 不需要 Docker / PostgreSQL / Redis / JWT / 登录，也无需任何外部独立服务。
#
# 复制为 .env 后按需填写下方 LLM Key（BYOK）。未配置 API Key 时，
# 对话回复会使用明确的模拟响应，其余本地功能不受影响。
# ============================================================================

# ---- 运行形态（Local Web / 单用户 / loopback）----
APP_ENV=local
PRIVATE_APP=true
DEBUG=false
HOST=127.0.0.1
PORT=8000

# ---- 本地数据（Askora 管理，无需手工配置）----
# 数据根目录：{ASKORA_DATA_DIR}/askora.db、documents/、indexes/、cache/ 等。
# 默认 ./data；如需迁移数据位置，取消注释并设置绝对路径。
# ASKORA_DATA_DIR=./data
# 数据库：默认解析为 {ASKORA_DATA_DIR}/askora.db（SQLite）。
# 只有需要 CI / 兼容性验证时才需要显式设置 DATABASE_URL。
# DATABASE_URL=sqlite+aiosqlite:///./data/askora.db

# ---- 数据保护密钥（本地数据加密，非登录口令）----
# 私人 App 仍建议使用随机密钥。可用 `openssl rand -hex 32` 生成。
KEK_MASTER_KEY=replace-with-another-random-secret-at-least-32-characters

# ---- BYOK：外部 AI 提供商（自行填写，仅保存在本机）----
# 只填写实际使用的供应商；未配置的供应商对应对话返回明确的模拟响应。
LLM_DEFAULT_PROVIDER=deepseek
LLM_DEEPSEEK_API_KEY=
LLM_DEEPSEEK_MODEL=deepseek-chat
LLM_QWEN_API_KEY=
LLM_QWEN_MODEL=qwen-turbo
LLM_DOUBAO_API_KEY=
LLM_DOUBAO_MODEL=doubao-pro-32k
LLM_ZHIPU_API_KEY=
LLM_ZHIPU_MODEL=glm-4.7-flash
LLM_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_ZHIPU_THINKING_ENABLED=false
LLM_MATH_PROVIDER=deepseek
LLM_TIMEOUT=30

EMBEDDING_PROVIDER=qwen
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com
EMBEDDING_MODEL=text-embedding-v2
EMBEDDING_DIMENSION=1536

# ---- 前端来源（loopback only）----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null,file://

# ============================================================================
# 可选开发 / CI 配置（不是 v1 最终用户运行前提）
# 以下仅用于开发联调、CI 兼容性验证或历史兼容模式，不进入默认产品运行路径。
# ============================================================================

# ---- Redis（可选：缓存 / 开发 / 兼容性优化）----
# 正常 Local Web 默认不连接 Redis；设置后仅作为可重建 cache 使用，
# 不作为任何学习 / 任务 / 幂等正确性的唯一来源。
# REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_PASSWORD=
# REDIS_POOL_SIZE=20

# ---- PostgreSQL（可选：CI / 兼容性验证 / 未来可选服务模式）----
# 生产-local 不使用 PostgreSQL；仅当运行 CI 跨数据库兼容性测试或
# 显式运行服务兼容模式时才需要。
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/socratic_learning
# POSTGRES_PASSWORD=replace-with-a-random-database-password

# ---- Docker Compose（可选：开发 / 兼容模式）----
# 根目录 compose 只作为开发 / 测试 / 兼容运行方式之一，不是 v1 最终用户运行前提。
# 使用 docker compose 时，Compose 会覆盖 DATABASE_URL / REDIS_URL 为容器地址。

# ---- 其他可选开关 ----
ENABLE_ORCHESTRATOR_DEBUG_API=false
LOG_LEVEL=INFO
LOG_FORMAT=json
PROMETHEUS_ENABLED=true