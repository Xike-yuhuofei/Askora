# 本地源码开发默认配置。不要把真实密钥提交到版本库。
APP_ENV=local
PRIVATE_APP=true
DEBUG=false
HOST=127.0.0.1
PORT=8000

# 本地数据根目录（Askora 管理）。不设置 DATABASE_URL 时默认解析为
# {ASKORA_DATA_DIR}/askora.db（SQLite）。Docker Compose 会覆盖为 PostgreSQL。
ASKORA_DATA_DIR=./data
# DATABASE_URL=sqlite+aiosqlite:///./data/askora.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10

# Redis 为可选优化；正常 Local Web 默认不连接。
# REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_PASSWORD=
# REDIS_POOL_SIZE=20

# 私人 App 仍必须使用随机密钥。可用 `openssl rand -hex 32` 生成。
KEK_MASTER_KEY=replace-with-another-random-secret-at-least-32-characters

# 仅填写实际使用的供应商；未配置时对话返回明确的模拟响应。
LLM_DEFAULT_PROVIDER=deepseek
LLM_DEEPSEEK_API_KEY=
LLM_DEEPSEEK_MODEL=deepseek-chat
LLM_QWEN_API_KEY=
LLM_QWEN_MODEL=qwen-turbo
LLM_DOUBAO_API_KEY=
LLM_DOUBAO_MODEL=doubao-pro-32k
LLM_ZHIPU_API_KEY=
LLM_ZHIPU_MODEL=glm-4.7-flash
LLM_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_ZHIPU_THINKING_ENABLED=false
LLM_MATH_PROVIDER=deepseek
LLM_TIMEOUT=30

EMBEDDING_PROVIDER=qwen
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com
EMBEDDING_MODEL=text-embedding-v2
EMBEDDING_DIMENSION=1536

LOCAL_STORAGE_BASE_PATH=./data/documents
LOCAL_STORAGE_MAX_FILE_SIZE_MB=50
LOCAL_STORAGE_MAX_TOTAL_SIZE_GB=2
LOCAL_STORAGE_CHUNK_MIN_TOKENS=200
LOCAL_STORAGE_CHUNK_MAX_TOKENS=800
LOCAL_STORAGE_ARCHIVE_MAX_ENTRIES=5000
LOCAL_STORAGE_ARCHIVE_MAX_ENTRY_SIZE_MB=50
LOCAL_STORAGE_ARCHIVE_MAX_UNCOMPRESSED_SIZE_MB=250
LOCAL_STORAGE_ARCHIVE_MAX_COMPRESSION_RATIO=100

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,null,file://
ENABLE_ORCHESTRATOR_DEBUG_API=false
LOG_LEVEL=INFO
LOG_FORMAT=json
PROMETHEUS_ENABLED=true
